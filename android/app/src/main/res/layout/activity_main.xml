<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="bounds"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chip" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="手机算路 · 蓝牙推送到圆屏"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- 搜索 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_search"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="background"
        android:paddingStart="13dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="搜索"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/et_dest"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="搜索目的地，或填 纬度,经度"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="搜索"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 出行方式：默认摩托（不走高速、避开收费） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出行方式"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/ll_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 高德 Key（平时折叠在设置里，点右上角齿轮展开） -->
    <LinearLayout
        android:id="@+id/card_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:orientation="vertical"
        android:outlineProvider="background"
        android:padding="13dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高德 Web 服务 Key"
            android:textColor="@color/ink2"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@null"
            android:hint="粘贴 lbs.amap.com 申请的 32 位 Key"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="填了才能按名字搜地点、自动算路。服务平台要选「Web服务」。"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 历史记录 -->
    <LinearLayout
        android:id="@+id/row_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近搜过"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btn_history_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="清空"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 实时地图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card"
        android:clipToOutline="true"
        android:elevation="2dp"
        android:outlineProvider="background">

        <WebView
            android:id="@+id/wv_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btn_myloc"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="我的位置"
            android:elevation="3dp"
            android:src="@drawable/ic_my_location" />

        <ImageButton
            android:id="@+id/btn_layer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="切换图层"
            android:elevation="3dp"
            android:src="@drawable/ic_layers" />
    </FrameLayout>

    <!-- 行程信息卡：选中目的地算路成功后显示 -->
    <LinearLayout
        android:id="@+id/card_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_eta"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingTop="12dp"
        android:paddingEnd="15dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_trip_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_trip_dest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_trip_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 搜索结果 -->
    <ListView
        android:id="@+id/lv_poi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToOutline="true"
        android:divider="@color/line"
        android:dividerHeight="1dp"
        android:elevation="2dp"
        android:outlineProvider="background" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minLines="2"
        android:text="等待操作"
        android:textColor="@color/ink2"
        android:textSize="12sp" />

    <!-- 崩溃日志（平时隐藏） -->
    <TextView
        android:id="@+id/tv_crash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_crash"
        android:maxLines="10"
        android:padding="10dp"
        android:textColor="@color/red"
        android:textIsSelectable="true"
        android:textSize="11sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_copy_crash"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_btn_outline"
        android:minHeight="0dp"
        android:text="复制崩溃日志"
        android:textAllCaps="false"
        android:textColor="@color/red"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 底部操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:elevation="0dp"
            android:minHeight="0dp"
            android:outlineProvider="none"
            android:stateListAnimator="@null"
            android:text="停止推送"
            android:textAllCaps="false"
            android:textColor="@color/ink2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:elevation="0dp"
            android:minHeight="0dp"
            android:outlineProvider="none"
            android:stateListAnimator="@null"
            android:text="开始推送"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
